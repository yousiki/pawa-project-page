---
import { clips, clipUrl, heroPoster } from "../data/media";
import { arxivUrl, pdfUrl, site } from "../data/site";
import Icon from "./Icon.astro";

const clip = clips.heroObserver;
const poster = await heroPoster();

const links = [
  { href: arxivUrl, icon: "arxiv", label: "arXiv", soon: "arXiv · soon" },
  { href: pdfUrl, icon: "pdf", label: "PDF", soon: null },
  { href: site.code, icon: "code", label: "Code", soon: "Code · soon" },
  {
    href: site.dataset,
    icon: "database",
    label: "Dataset",
    soon: "Dataset · soon",
  },
  { href: "#citation", icon: "quote", label: "BibTeX", soon: null },
] as const;
---

<header
  class="relative isolate flex min-h-[100svh] flex-col overflow-hidden bg-night text-white"
  id="top"
>
  <video
    aria-hidden="true"
    autoplay
    class="-z-30 absolute inset-0 size-full scale-105 object-cover opacity-60"
    data-hero
    disablepictureinpicture
    loop
    muted
    playsinline
    poster={poster.src}
    preload="auto"
    src={clipUrl(clip)}
    tabindex="-1"
  ></video>
  <div
    class="-z-20 absolute inset-0 bg-[radial-gradient(ellipse_75%_65%_at_50%_42%,rgb(6_8_12/0.35),rgb(6_8_12/0.82)_70%,#06080c)]"
  ></div>
  <!-- A faint latitude and longitude grid, the panorama motif. -->
  <svg
    aria-hidden="true"
    class="-z-10 absolute inset-0 size-full text-white/[0.07] [mask-image:radial-gradient(ellipse_at_center,black_20%,transparent_70%)]"
  >
    <defs>
      <pattern height="64" id="grid" patternUnits="userSpaceOnUse" width="64">
        <path
          d="M64 0H0V64"
          fill="none"
          stroke="currentColor"
          stroke-width="1"
        ></path>
      </pattern>
    </defs>
    <rect fill="url(#grid)" height="100%" width="100%"></rect>
  </svg>

  <div
    class="mx-auto flex w-full max-w-5xl flex-1 flex-col items-center justify-center px-5 pt-24 pb-40 text-center sm:px-8"
  >
    <p
      class="mb-8 inline-flex items-center gap-2 rounded-full border border-white/15 bg-white/5 px-3.5 py-1.5 font-medium text-[13px] text-white/80 backdrop-blur-md"
    >
      <span class="relative flex size-2">
        <span
          class="absolute inline-flex size-full animate-ping rounded-full bg-teal-soft opacity-60"
        ></span>
        <span
          class="relative inline-flex size-2 rounded-full bg-teal-soft"
        ></span>
      </span>
      arXiv preprint · {site.year}
    </p>

    <h1>
      <span
        class="text-gradient block font-semibold text-[clamp(4.5rem,15vw,10rem)] leading-[0.9] tracking-[-0.05em]"
      >
        {site.name}
      </span>
      <span
        class="mt-5 block text-balance font-serif text-[clamp(1.6rem,4.2vw,3.1rem)] text-white/95 leading-[1.08]"
      >
        {site.subtitle}
      </span>
    </h1>
    <p class="mt-6 max-w-2xl text-pretty text-base text-white/65 sm:text-lg">
      {site.tagline}
    </p>

    <ul
      class="mt-10 flex max-w-3xl flex-wrap justify-center gap-x-5 gap-y-2 text-[15px] sm:text-base"
    >
      {site.authors.map((a) => (
  <li class="whitespace-nowrap text-white/90">
    {a.name}
    <sup class="ml-0.5 text-[0.7em] text-white/50">
      {a.affiliations.join(",")}
      {a.marks?.join("")}
    </sup>
  </li>
))}
    </ul>
    <ul
      class="mt-4 flex flex-wrap justify-center gap-x-4 gap-y-1 text-[13px] text-white/55 sm:text-sm"
    >
      {site.affiliations.map((name, i) => (
  <li>
    <sup>{i + 1}</sup>
    {name}
  </li>
))}
    </ul>
    <p class="mt-2 text-white/40 text-xs">
      {site.notes.map(([mark, text]) => `${mark} ${text}`).join("   ·   ")}
    </p>

    <nav
      aria-label="Paper resources"
      class="mt-10 flex flex-wrap justify-center gap-2.5"
    >
      {links.map((l) =>
  l.href ? (
    <a
      class="group inline-flex items-center gap-2 rounded-full bg-white px-5 py-2.5 font-medium text-night text-sm shadow-[0_8px_30px_-8px_rgb(95_224_192/0.5)] transition duration-300 ease-out-expo hover:-translate-y-0.5 hover:shadow-[0_12px_36px_-8px_rgb(95_224_192/0.7)]"
      href={l.href}
    >
      <Icon name={l.icon} />
      {l.label}
    </a>
  ) : (
    l.soon && (
      <span
        class="inline-flex cursor-default items-center gap-2 rounded-full border border-white/15 bg-white/5 px-5 py-2.5 font-medium text-sm text-white/55 backdrop-blur-md"
        title="Coming with the public release"
      >
        <Icon name={l.icon} />
        {l.soon}
      </span>
    )
  )
)}
    </nav>
  </div>

  <a
    class="absolute bottom-24 left-1/2 flex -translate-x-1/2 flex-col items-center gap-2 text-[11px] text-white/50 uppercase tracking-[0.2em] transition hover:text-white"
    href="#overview"
  >
    Explore
    <span class="animate-[cue_2.4s_ease-in-out_infinite]"
      ><Icon name="down" /></span
    >
  </a>
</header>
