---
import { arxivUrl, site } from "../data/site";

const sections = [
  ["overview", "Overview"],
  ["dataset", "Dataset"],
  ["method", "Method"],
  ["results", "Results"],
  ["citation", "Citation"],
] as const;
---

<nav
  aria-label="Sections"
  class="-translate-x-1/2 pointer-events-none fixed top-3 left-1/2 z-40 w-[calc(100%-1.5rem)] max-w-3xl -translate-y-4 opacity-0 transition duration-500 ease-out-expo data-[visible]:pointer-events-auto data-[visible]:translate-y-0 data-[visible]:opacity-100"
  data-nav
>
  <div
    class="flex items-center gap-1 rounded-full border border-white/10 bg-night/75 py-1.5 pr-1.5 pl-1.5 text-[13px] sm:pl-4 sm:text-sm text-white/70 shadow-[0_10px_40px_-10px_rgb(6_8_12/0.5)] backdrop-blur-xl backdrop-saturate-150"
  >
    <a
      class="text-gradient mr-auto hidden font-semibold text-base tracking-tight sm:inline"
      href="#top"
      >{site.name}</a
    >
    <div
      class="mx-auto flex items-center overflow-x-auto [scrollbar-width:none] sm:mx-0"
    >
      {sections.map(([id, label]) => (
  <a
    class="whitespace-nowrap rounded-full px-2.5 py-1.5 transition hover:text-white aria-[current=true]:bg-white/10 aria-[current=true]:text-white sm:px-3"
    data-nav-link={id}
    href={`#${id}`}
  >
    {label}
  </a>
))}
    </div>
    {arxivUrl && (
  <a
    class="ml-1 hidden rounded-full bg-white px-3.5 py-1.5 font-medium text-night transition hover:bg-teal-soft sm:inline-block"
    href={arxivUrl}
  >
    arXiv
  </a>
)}
  </div>
</nav>
