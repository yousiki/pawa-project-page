---
import Layout from "../layouts/Layout.astro";
---

<Layout title="Page not found · PAWA">
  <main
    class="grid min-h-svh place-items-center bg-night px-6 text-center text-white"
  >
    <div>
      <p class="text-gradient font-semibold text-8xl tracking-tighter">404</p>
      <p class="mt-4 text-white/60">This page is outside the panorama.</p>
      <a
        class="mt-8 inline-block rounded-full bg-white px-5 py-2.5 font-medium text-night text-sm"
        href="/"
        >Back to PAWA</a
      >
    </div>
  </main>
</Layout>
